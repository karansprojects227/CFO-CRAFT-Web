
RewriteEngine On

# 1. Direct .html URLs ko clean URLs par redirect karo
RewriteCond %{THE_REQUEST} \s/+(.+)\.html(?:[\s?]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# 2. Existing files aur directories ko as-is serve karo
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Clean URLs ko corresponding HTML files se serve karo
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
